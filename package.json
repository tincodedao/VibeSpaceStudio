{
  "name": "vibespace-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@vibespace/frontend",
    "dev:frontend": "npm run dev --workspace=@vibespace/frontend",
    "dev:backend": "npm run dev --workspace=@vibespace/backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=@vibespace/frontend",
    "build:backend": "npm run build --workspace=@vibespace/backend",
    "preview": "npm run preview --workspace=@vibespace/frontend",
    "start:backend": "npm run start --workspace=@vibespace/backend"
  }
}
